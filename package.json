{
  "name": "cyberpunk-combat-kit",
  "version": "0.1.1",
  "private": true,
  "description": "Automação de combate e efeitos audiovisuais para Cyberpunk RED – CORE no Foundry VTT.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "build": "vite build",
    "build:personal": "node scripts/build-personal.mjs",
    "check:private": "node scripts/check-private.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run check:private",
    "package": "npm run check && node scripts/package.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  },
  "license": "MIT"
}
